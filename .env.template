# Application
# Selects the runtime environment and enables production safety checks.
NODE_ENV=development

# Internal port where NestJS listens; this is not necessarily the public URL exposed by Nginx.
PORT=8000

# Public URLs
# Absolute public URL of the backend and authorization server, as seen by browsers and clients.
# The JWT issuer is derived from this value. HTTP and HTTPS are supported.
IDENTITY_HUB_PUBLIC_URL=http://localhost:8000

# Absolute public URL of the Angular application.
# Backend and UI normally use different ports in development, so CORS is enabled automatically.
# Both URLs may share an origin when Nginx routes UI and API traffic.
# HTTP is allowed for internal or transitional deployments, but HTTPS is strongly recommended.
IDENTITY_HUB_UI_URL=http://localhost:4200

# Database
# PostgreSQL connection used by NestJS and the TypeORM command-line data source.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=identity_hub
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Use true only for local development without migrations.
# This must remain false in production, where migrations must be used.
DATABASE_SYNCHRONIZE=false

# RRHH internal employee directory
# Used by controlled migration scripts to validate active employees.
RRHH_INTERNAL_URL=http://localhost:3001
RRHH_ACCESS_TOKEN=change-me

# Redis
# Redis connection for sessions and temporary OAuth state; supports redis:// and rediss:// URLs.
REDIS_URL=redis://localhost:6379

# JWT signing keys
# Relative paths are supported during local development.
# Use absolute paths outside the deployed project in production and protect the private key.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Password actions
# Expiration values must be positive integer seconds; initial account setup defaults to 24 hours.
PASSWORD_INITIAL_SETUP_TTL_SECONDS=86400

# Password reset and recovery default to 60 minutes.
PASSWORD_RESET_TTL_SECONDS=3600

# SMTP
# SMTP transport used for password action and password change messages.
SMTP_HOST=localhost
SMTP_PORT=25

# Enables direct TLS from connection start; this is not the same as STARTTLS.
SMTP_SECURE=false

# Configure both values for authenticated SMTP, or leave both absent for an unauthenticated relay.
# SMTP_USERNAME=
# SMTP_PASSWORD=

SMTP_FROM_ADDRESS=identity-hub@example.org
SMTP_FROM_NAME=Identity Hub

# Identity cookies
# Set true whenever the service is published over HTTPS.
# With HTTP, normally use false together with SameSite=lax.
IDENTITY_COOKIE_SECURE=false

# Allowed values: lax, strict, none. SameSite=none requires HTTPS and a secure cookie.
IDENTITY_COOKIE_SAME_SITE=lax

# Initial administrator bootstrap
# Use only for controlled creation of the first administrator by running npm run bootstrap:run manually.
# Remove unneeded secrets from the environment after the bootstrap completes.
# BOOTSTRAP_ADMIN_LOGIN=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=Identity Hub Admin
